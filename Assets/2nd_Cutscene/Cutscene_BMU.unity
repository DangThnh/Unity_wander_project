  m_Name: 
  m_EditorClassIdentifier: 
  dialogueSequence:
  - text: "Sure is chilly up here\u2026 "
    typingSpeed: 0.05
    delayBeforeStart: 5
    displayDuration: 3
  - text: This is one of the towering building of the company after all.
    typingSpeed: 0.05
    delayBeforeStart: 2
    displayDuration: 4
  - text: Thousands dream of reaching the top of this building.  How irony.
    typingSpeed: 0.05
    delayBeforeStart: 2
    displayDuration: 4
  - text: So, this is what the King's vision looks like...
    typingSpeed: 0.08
    delayBeforeStart: 5
    displayDuration: 4
