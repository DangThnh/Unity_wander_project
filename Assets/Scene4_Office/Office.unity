  m_Name: 
  m_EditorClassIdentifier: 
  briefingTextUI: {fileID: 923294063}
  briefingTexts:
  - That must be the security guard of this place.
  - Is he sleeping?
  - Wait, is that the security card? The one for the elevator?
  - I must get it.
  - But there's so much stuff around, I could make unnecessary noises and wake him
    up.
  - I must find a way to get closer.
  - That must be the vent.
  - What if I can some how get in it, i might be able to reach the card.
  briefingCameras:
  - {fileID: 741406319}
  - {fileID: 994008611}
  - {fileID: 806777747}
  - {fileID: 1646296296}
